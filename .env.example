# Copy this file to .env and replace the example values.
POSTGRES_PASSWORD=replace_with_a_local_password

# JDBC URL format: jdbc:snowflake://<account_identifier>.snowflakecomputing.com
SNOWFLAKE_URL=jdbc:snowflake://your_account.snowflakecomputing.com
# Snowflake account identifier without the domain, required by dbt.
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USERNAME=your_snowflake_user
# Set locally; never commit your real password.
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=CHURN_DB
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_GOLD_SCHEMA=GOLD
SNOWFLAKE_OBT_TABLE=OBT_CUSTOMER_CHURN
# Optional Snowflake role:
SNOWFLAKE_ROLE=
